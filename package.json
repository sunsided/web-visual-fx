{
	"name": "web-visual-fx",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build --output-dir build/storybook",
		"lint:fix": "eslint --fix . && prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.3",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/sveltekit": "^10.6.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.3",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.6.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Playground for modern visual effects on the web",
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": ">=22.17"
	}
}
